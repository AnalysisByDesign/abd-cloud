#!/usr/bin/env bash
# Keeps one single-use runner waiting in slot N: register just in time, run
# one job, repeat. launchd runs one supervisor per slot (KeepAlive), as
# svc-ghrunner.
#   abd-runner-supervise <slot>
#
# Each slot has its own container (abd-runner-<slot>) and work folder
# (${WORK_ROOT}/<slot>). All slots share the cache volume, mounted at
# /cache, so Composer, npm and the tool cache (setup-node and similar)
# survive from job to job.
#
# The runner shares the VM's network (--network host) so ports that jobs
# publish on the host engine are reachable on 127.0.0.1, as on a hosted
# runner. Slots share that network too: jobs that can run at the same time
# must not publish the same fixed host port.
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

slot="${1:?usage: abd-runner-supervise <slot>}"
name="${CONTAINER_NAME}-${slot}"
work="${WORK_ROOT}/${slot}"
runner_id=""

cleanup() {
    docker rm -f "${name}" >/dev/null 2>&1 || true
    if [ -n "${runner_id}" ]; then
        gh_api "$(gh_token)" DELETE "${GH_SCOPE}/actions/runners/${runner_id}" >/dev/null 2>&1 || true
    fi
    exit 0
}
trap cleanup INT TERM

# At boot Colima restarts dockerd while starting; let it settle before
# registering anything.
wait_for_engine

while true; do
    if ! docker info >/dev/null 2>&1; then
        log "slot ${slot}: Docker not reachable at ${DOCKER_HOST}; waiting for it to settle"
        wait_for_engine
        continue
    fi

    # A runner left over from an earlier supervisor: let it finish its job.
    if [ "$(docker container inspect -f '{{.State.Running}}' "${name}" 2>/dev/null)" = true ]; then
        log "slot ${slot}: ${name} already running; waiting for it"
        docker wait "${name}" >/dev/null 2>&1 &
        wait $! || true
        continue
    fi
    docker rm -f "${name}" >/dev/null 2>&1 || true

    # Fresh, empty work folder owned by abd, at the same path in the VM.
    # Cache directories exist and belong to abd; their contents are kept.
    if ! docker run --rm --user 0 --entrypoint sh \
            -v "${work}:${work}" -v "${CACHE_VOLUME}:/cache" "${RUNNER_IMAGE}" -c "
                find '${work}' -mindepth 1 -delete && chown 10001:10001 '${work}' &&
                mkdir -p /cache/composer /cache/npm /cache/toolcache &&
                chown 10001:10001 /cache /cache/composer /cache/npm /cache/toolcache"; then
        log "slot ${slot}: could not prepare ${work} with ${RUNNER_IMAGE}; retrying in 60s"
        sleep 60
        continue
    fi

    sock_gid="$(docker run --rm --entrypoint stat -v "${DOCKER_SOCK}:${DOCKER_SOCK}" \
        "${RUNNER_IMAGE}" -c %g "${DOCKER_SOCK}")" || { sleep 60; continue; }

    body="$(jq -nc \
        --arg name "abd-$(hostname -s)-${slot}-$(date +%s)" \
        --argjson group "${RUNNER_GROUP_ID}" \
        --arg labels "${RUNNER_LABELS}" \
        --arg work "${work}" \
        '{name: $name, runner_group_id: $group, labels: ($labels | split(",")), work_folder: $work}')"
    if ! resp="$(gh_api "$(gh_token)" POST "${GH_SCOPE}/actions/runners/generate-jitconfig" "${body}")"; then
        log "slot ${slot}: registration failed; retrying in 60s"
        sleep 60
        continue
    fi
    runner_id="$(jq -r .runner.id <<<"${resp}")"
    log "slot ${slot}: runner ${runner_id} registered, waiting for a job"

    ACTIONS_RUNNER_JITCONFIG="$(jq -r .encoded_jit_config <<<"${resp}")" \
        docker run --rm --name "${name}" \
            --network host \
            -e ACTIONS_RUNNER_JITCONFIG \
            -e COMPOSER_CACHE_DIR=/cache/composer \
            -e npm_config_cache=/cache/npm \
            -e RUNNER_TOOL_CACHE=/cache/toolcache \
            -e AGENT_TOOLSDIRECTORY=/cache/toolcache \
            -v "${DOCKER_SOCK}:${DOCKER_SOCK}" --group-add "${sock_gid}" \
            -v "${work}:${work}" \
            -v "${CACHE_VOLUME}:/cache" \
            "${RUNNER_IMAGE}" &
    # Waiting in the background lets the TERM trap run immediately.
    wait $! || log "slot ${slot}: runner ${runner_id} exited with $?"

    # A single-use runner removes itself after its job; this catches one
    # that stopped before taking a job.
    gh_api "$(gh_token)" DELETE "${GH_SCOPE}/actions/runners/${runner_id}" >/dev/null 2>&1 || true
    runner_id=""
    sleep 2
done
