#!/usr/bin/env bash
# Keeps one single-use runner waiting in slot N: register just in time, run
# one job, reset the slot, repeat. launchd runs one supervisor per slot
# (KeepAlive), as svc-ghrunner.
#   abd-runner-supervise <slot>
#
# Each slot is two containers on the shared engine (svc-colima's Colima):
#
#   abd-runner-dind-<n>  a private Docker engine (docker:dind, privileged).
#                        Jobs' containers, services, networks, volumes and
#                        image builds live in it and nowhere else, so a job
#                        cannot see or touch the dev stack or another slot.
#                        Its /var/lib/docker is a volume, so image layers
#                        stay cached between jobs.
#   abd-runner-<n>       the runner (abd/github-runner), talking only to its
#                        slot's engine through a socket in a shared volume,
#                        and sharing that engine's network, so ports that
#                        jobs publish answer on 127.0.0.1 as on a hosted
#                        runner.
#
# The work folder is a volume mounted at the same path in both, so bind
# mounts made by jobs resolve in the slot's engine. All slots share the
# cache volume (Composer, npm, the tool cache), mounted in the runner only.
# Memory and CPU are capped per container; the engine's cap covers every
# container a job starts in it.
#
# Disk: before each job the slot's image cache is emptied if it exceeds
# SLOT_CACHE_MAX_GB or the Mac has less than HOST_MIN_FREE_GB free, and the
# freed blocks are trimmed back to macOS. While the Mac stays below the
# minimum the slot takes no jobs, so the heartbeat lapses and workflows fall
# back to hosted runners.
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

slot="${1:?usage: abd-runner-supervise <slot>}"
name="${CONTAINER_NAME}-${slot}"
dind="${CONTAINER_NAME}-dind-${slot}"
# The same path in every slot (each has its own volume and engine), and the
# same as on GitHub-hosted runners: absolute paths that jobs record, such as
# those in coverage files, then match whichever runner reads them.
work="${WORK_ROOT}"
label="com.abd.github-runner=${slot}"
vol_docker="${CONTAINER_NAME}-docker-${slot}"
vol_work="${CONTAINER_NAME}-work-${slot}"
vol_sock="${CONTAINER_NAME}-sock-${slot}"
sock_dir=/var/run/dind
slot_docker="unix://${sock_dir}/docker.sock"
runner_id=""

cleanup() {
    docker rm -f "${name}" "${dind}" >/dev/null 2>&1 || true
    if [ -n "${runner_id}" ]; then
        gh_api "$(gh_token)" DELETE "${GH_SCOPE}/actions/runners/${runner_id}" >/dev/null 2>&1 || true
    fi
    exit 0
}
trap cleanup INT TERM

# Runs a shell command inside the slot's engine container, with its docker
# CLI pointed at the slot's own engine.
in_dind() { docker exec -e DOCKER_HOST="${slot_docker}" "${dind}" sh -c "$1"; }

# Starts the slot's engine if it is not running, and waits for it to answer.
ensure_dind() {
    if [ "$(docker container inspect -f '{{.State.Running}}' "${dind}" 2>/dev/null)" = true ]; then
        return 0
    fi
    docker rm -f "${dind}" >/dev/null 2>&1 || true
    log "slot ${slot}: starting ${dind} (${DIND_IMAGE})"
    # --group 10001: the socket belongs to the runner's abd group.
    # DOCKER_TLS_CERTDIR empty: no TCP listener at all, the socket only.
    docker run -d --name "${dind}" --label "${label}" --privileged \
        --memory "${DIND_MEMORY}" --memory-swap "${DIND_MEMORY}" --cpus "${DIND_CPUS}" \
        -e DOCKER_TLS_CERTDIR= \
        -v "${vol_docker}:/var/lib/docker" \
        -v "${vol_work}:${work}" \
        -v "${vol_sock}:${sock_dir}" \
        "${DIND_IMAGE}" --host="${slot_docker}" --group=10001 >/dev/null
    local _
    for _ in $(seq 1 30); do
        if in_dind 'docker info >/dev/null 2>&1'; then
            return 0
        fi
        sleep 2
    done
    log "slot ${slot}: ${dind} did not answer within 60s"
    return 1
}

# Leaves the slot as a new job expects it: nothing running in its engine,
# no networks or volumes left by the last job (images stay, as cache), and
# an empty work folder owned by the runner's user.
reset_slot() {
    in_dind "
        ids=\$(docker ps -aq); [ -z \"\${ids}\" ] || docker rm -f \${ids} >/dev/null
        docker network prune -f >/dev/null
        docker volume prune -af >/dev/null
        find '${work}' -mindepth 1 -delete && chown 10001:10001 '${work}'"
}

# Size of the slot's engine data (image cache, build cache), in whole GB.
slot_used_gb() { in_dind 'du -sk /var/lib/docker' | awk '{ print int($1 / 1048576) }'; }

# Hands blocks freed inside the VM back to macOS, where the VM's disk file
# can shrink. The slot's engine is privileged, so it can trim the VM
# filesystem under its volume. Best effort: logged, never fatal.
trim_slot() {
    in_dind 'fstrim -v /var/lib/docker' 2>&1 | sed "s/^/slot ${slot}: /" || log "slot ${slot}: fstrim failed"
}

# Empties the slot's image and build cache when it is over its cap or the
# Mac is short of space. Returns non-zero while the Mac is still short.
check_disk() {
    local used free
    used="$(slot_used_gb)"
    free="$(host_free_gb)"
    if [ "${used}" -gt "${SLOT_CACHE_MAX_GB}" ] || [ "${free}" -lt "${HOST_MIN_FREE_GB}" ]; then
        log "slot ${slot}: cache ${used} GB (cap ${SLOT_CACHE_MAX_GB}), Mac ${free} GB free (minimum ${HOST_MIN_FREE_GB}); emptying the cache"
        in_dind 'docker image prune -af >/dev/null; docker builder prune -af >/dev/null' || true
        trim_slot
        free="$(host_free_gb)"
    fi
    if [ "${free}" -lt "${HOST_MIN_FREE_GB}" ]; then
        log "slot ${slot}: Mac has ${free} GB free (minimum ${HOST_MIN_FREE_GB}); taking no jobs"
        return 1
    fi
}

# At boot Colima restarts dockerd while starting; let it settle first.
wait_for_engine

while true; do
    if ! docker info >/dev/null 2>&1; then
        log "slot ${slot}: Docker not reachable at ${DOCKER_HOST}; waiting for it to settle"
        wait_for_engine
        continue
    fi

    # A runner left over from an earlier supervisor: let it finish its job.
    if [ "$(docker container inspect -f '{{.State.Running}}' "${name}" 2>/dev/null)" = true ]; then
        log "slot ${slot}: ${name} already running; waiting for it"
        docker wait "${name}" >/dev/null 2>&1 &
        wait $! || true
        continue
    fi
    docker rm -f "${name}" >/dev/null 2>&1 || true

    if ! ensure_dind || ! reset_slot; then
        log "slot ${slot}: could not prepare the slot's engine; retrying in 60s"
        docker rm -f "${dind}" >/dev/null 2>&1 || true
        sleep 60
        continue
    fi

    if ! check_disk; then
        sleep 300
        continue
    fi

    # Cache directories exist and belong to the runner; contents are kept.
    if ! docker run --rm --user 0 --entrypoint sh --label "${label}" \
            -v "${CACHE_VOLUME}:/cache" "${RUNNER_IMAGE}" -c "
                mkdir -p /cache/composer /cache/npm /cache/toolcache &&
                chown 10001:10001 /cache /cache/composer /cache/npm /cache/toolcache"; then
        log "slot ${slot}: could not prepare ${CACHE_VOLUME} with ${RUNNER_IMAGE}; retrying in 60s"
        sleep 60
        continue
    fi

    body="$(jq -nc \
        --arg name "abd-$(hostname -s)-${slot}-$(date +%s)" \
        --argjson group "${RUNNER_GROUP_ID}" \
        --arg labels "${RUNNER_LABELS}" \
        --arg work "${work}" \
        '{name: $name, runner_group_id: $group, labels: ($labels | split(",")), work_folder: $work}')"
    if ! resp="$(gh_api "$(gh_token)" POST "${GH_SCOPE}/actions/runners/generate-jitconfig" "${body}")"; then
        log "slot ${slot}: registration failed; retrying in 60s"
        sleep 60
        continue
    fi
    runner_id="$(jq -r .runner.id <<<"${resp}")"
    log "slot ${slot}: runner ${runner_id} registered, waiting for a job"

    ACTIONS_RUNNER_JITCONFIG="$(jq -r .encoded_jit_config <<<"${resp}")" \
        docker run --rm --name "${name}" --label "${label}" \
            --network "container:${dind}" \
            --memory "${RUNNER_MEMORY}" --memory-swap "${RUNNER_MEMORY}" --cpus "${RUNNER_CPUS}" \
            -e ACTIONS_RUNNER_JITCONFIG \
            -e DOCKER_HOST="${slot_docker}" \
            -e COMPOSER_CACHE_DIR=/cache/composer \
            -e npm_config_cache=/cache/npm \
            -e RUNNER_TOOL_CACHE=/cache/toolcache \
            -e AGENT_TOOLSDIRECTORY=/cache/toolcache \
            -v "${vol_sock}:${sock_dir}" \
            -v "${vol_work}:${work}" \
            -v "${CACHE_VOLUME}:/cache" \
            "${RUNNER_IMAGE}" &
    # Waiting in the background lets the TERM trap run immediately.
    wait $! || log "slot ${slot}: runner ${runner_id} exited with $?"

    # A single-use runner removes itself after its job; this catches one
    # that stopped before taking a job.
    gh_api "$(gh_token)" DELETE "${GH_SCOPE}/actions/runners/${runner_id}" >/dev/null 2>&1 || true
    runner_id=""
    sleep 2
done
