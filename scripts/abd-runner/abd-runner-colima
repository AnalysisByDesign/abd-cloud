#!/usr/bin/env bash
# com.abd.github-runner.colima: the runner's own Colima VM, in the
# foreground so launchd supervises it. Separate from svc-colima's shared
# engine, so jobs cannot see or touch the dev stack's containers.
#
# Sizing applies when the VM is created; on an existing VM cpu and memory
# apply on restart and disk can only grow. vz is the native backend; if it
# will not boot in a daemon context, use qemu (as for svc-colima).
#
# Mounts: only an empty, read-only ~/vm-share. Colima mounts the whole home
# directory when no mount is given, and jobs are root on this VM, so that
# would hand them ~/etc (the App key and settings).
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"

exec colima start --foreground \
    --cpu "${COLIMA_CPU:-4}" --memory "${COLIMA_MEMORY:-6}" --disk "${COLIMA_DISK:-100}" \
    --vm-type "${COLIMA_VM_TYPE:-vz}" \
    --mount "${HOME}/vm-share"
