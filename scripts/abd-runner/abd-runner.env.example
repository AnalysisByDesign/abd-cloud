# abd-runner settings. Installed as ~svc-ghrunner/etc/abd-runner.env (mode
# 600, owned by svc-ghrunner); never committed. Nothing here is secret: the
# App private key is the separate file GH_APP_KEY_FILE.

# Where runners register and the heartbeat variable lives. Organisation
# scope; the runner group (RUNNER_GROUP_ID) limits which repositories use it.
GH_SCOPE=orgs/AnalysisByDesign

# GitHub App (organisation settings, Developer settings, GitHub Apps).
GH_APP_ID=
GH_APP_INSTALLATION_ID=
# Private key: mode 400, owned by svc-ghrunner.
GH_APP_KEY_FILE=${HOME}/etc/github-app.pem

# Image the host runs. A local tag set by hand (see README), never one CI
# builds, so a pull request cannot change the runner it runs on.
RUNNER_IMAGE=abd/github-runner:host

# Must match runs-on in the workflows.
RUNNER_LABELS=self-hosted,linux,arm64,abd
# The runner group restricted to selected repositories (README, step 4):
#   gh api orgs/AnalysisByDesign/actions/runner-groups --jq '.runner_groups[] | [.id, .name] | @tsv'
RUNNER_GROUP_ID=

# Runners waiting at once, one daemon per slot (rerun install.sh after
# changing it). Size the shared Colima VM to match (README, Sizing).
RUNNER_COUNT=2

# The shared engine: svc-colima's Colima, which also runs the dev stack.
# svc-ghrunner reaches it through the docker-users group (README, step 7).
# Jobs never see this engine: each slot runs them in its own engine.
DOCKER_HOST=unix:///Users/svc-colima/.colima/default/docker.sock

# Each slot's private engine (Docker in Docker). Pinned; bump deliberately.
DIND_IMAGE=docker:29.9.2-dind

# Caps per slot. The engine's cap covers everything a job starts in it
# (services such as MySQL, image builds); the runner's covers the job's
# own steps (PHP, Node). A slot can use at most the two together.
DIND_MEMORY=2g
DIND_CPUS=2
RUNNER_MEMORY=1536m
RUNNER_CPUS=2

# The runners' work folder: GitHub-hosted runners' path, the same in every
# slot, so absolute paths that jobs record (coverage files, for one) match
# between slots and hosted runners. Each slot's is its own volume, mounted
# at this path in the runner and in its slot's engine so bind mounts made
# by jobs resolve. Emptied before each job.
WORK_ROOT=/home/runner/work

# Docker volume shared by every slot and kept between jobs: Composer and npm
# caches and the tool cache. docker volume rm it to start clean.
CACHE_VOLUME=abd-runner-cache

HEARTBEAT_VAR=RUNNER_HEARTBEAT
CONTAINER_NAME=abd-runner

# Disk. Each slot empties its image and build cache before a job when the
# cache exceeds SLOT_CACHE_MAX_GB, or when the Mac's data volume has less
# than HOST_MIN_FREE_GB free; below that minimum slots take no jobs and the
# heartbeat lapses, so workflows fall back to hosted runners. The Colima
# VM's disk is a sparse file on that volume, so the Mac's free space, not
# the VM's, is what runs out (2026-11-12).
SLOT_CACHE_MAX_GB=12
HOST_MIN_FREE_GB=25
HOST_DATA_PATH=/System/Volumes/Data
