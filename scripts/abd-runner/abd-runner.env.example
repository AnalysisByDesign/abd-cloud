# abd-runner settings. Installed as ~svc-ghrunner/etc/abd-runner.env (mode
# 600, owned by svc-ghrunner); never committed. Nothing here is secret: the
# App private key is the separate file GH_APP_KEY_FILE.

# Where runners register and the heartbeat variable lives. Organisation
# scope; the runner group (RUNNER_GROUP_ID) limits which repositories use it.
GH_SCOPE=orgs/AnalysisByDesign

# GitHub App (organisation settings, Developer settings, GitHub Apps).
GH_APP_ID=
GH_APP_INSTALLATION_ID=
# Private key: mode 400, owned by svc-ghrunner.
GH_APP_KEY_FILE=${HOME}/etc/github-app.pem

# Image the host runs. A local tag set by hand (see README), never one CI
# builds, so a pull request cannot change the runner it runs on.
RUNNER_IMAGE=abd/github-runner:host

# Must match runs-on in the workflows.
RUNNER_LABELS=self-hosted,linux,arm64,abd
# The runner group restricted to selected repositories (README, step 4):
#   gh api orgs/AnalysisByDesign/actions/runner-groups --jq '.runner_groups[] | [.id, .name] | @tsv'
RUNNER_GROUP_ID=

# Runners waiting at once, one daemon per slot (rerun install.sh after
# changing it). Each slot can run a full job: size COLIMA_* to match.
RUNNER_COUNT=2

# Work folders, one per slot (${WORK_ROOT}/<slot>): a path inside the
# runner's Colima VM, mounted at the same path in the runner container, so
# bind mounts made by jobs resolve on the engine. Emptied before each job.
WORK_ROOT=/srv/abd-runner/work

# Docker volume shared by every slot and kept between jobs: Composer and npm
# caches and the tool cache. docker volume rm it to start clean.
CACHE_VOLUME=abd-runner-cache

# The runner's own Colima VM (not svc-colima's shared engine).
DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock
COLIMA_CPU=4
COLIMA_MEMORY=6
COLIMA_DISK=100

HEARTBEAT_VAR=RUNNER_HEARTBEAT
CONTAINER_NAME=abd-runner

# abd-runner-prune removes all unused images only above this disk use.
PRUNE_AT_PERCENT=75
