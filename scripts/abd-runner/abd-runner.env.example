# abd-runner host settings. Copy to abd-runner.env (not committed) and fill in.
# Nothing here is secret: the App private key lives in the login Keychain.

# Where runners register and the heartbeat variable lives:
#   orgs/AnalysisByDesign                              every private repo in the org
#   repos/AnalysisByDesign/abd-cloud-containers        one repository
GH_SCOPE=orgs/AnalysisByDesign

# GitHub App (Settings > Developer settings > GitHub Apps on the org).
GH_APP_ID=
GH_APP_INSTALLATION_ID=
# Keychain item holding the base64-encoded private key.
KEYCHAIN_SERVICE=abd-github-runner-app

# Image the host runs. A local tag set by hand (see README), never one CI
# builds, so a pull request cannot change the runner it runs on.
RUNNER_IMAGE=abd/github-runner:host

# Must match runs-on in the workflows.
RUNNER_LABELS=self-hosted,linux,arm64,abd
RUNNER_GROUP_ID=1

# Runners waiting at once, one launchd supervisor each (rerun install.sh
# after changing it). Each slot uses about a full job's CPU and memory.
RUNNER_COUNT=2

# Work folders, one per slot (${WORK_ROOT}/<slot>): same path in the Colima
# VM and in the runner container, so bind mounts made by jobs resolve on the
# host engine. Emptied before each job.
WORK_ROOT=/srv/abd-runner/work

# Docker volume shared by every slot and kept between jobs: Composer and npm
# caches and the tool cache. docker volume rm it to start clean.
CACHE_VOLUME=abd-runner-cache

# Colima's Docker socket on the Mac.
DOCKER_HOST=unix://${HOME}/.colima/default/docker.sock

HEARTBEAT_VAR=RUNNER_HEARTBEAT
CONTAINER_NAME=abd-runner

# abd-runner-prune removes all unused images only above this disk use.
PRUNE_AT_PERCENT=75
