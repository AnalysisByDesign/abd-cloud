#!/usr/bin/env bash
# Daily (launchd): keep Colima's disk in check without throwing away the
# image cache that makes jobs fast.
#
# Always: stopped containers, dangling images, unused volumes, build cache
# older than a week. Only when the engine's disk is above PRUNE_AT_PERCENT:
# every image no container uses, except the runner image. (Docker's "until"
# filter is image creation time, not last use, so an age filter would drop
# images such as mysql that jobs pull every day.)
set -euo pipefail
# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
: "${PRUNE_AT_PERCENT:=75}"

docker container prune -f --filter until=24h
docker image prune -f
docker volume prune -f   # anonymous volumes only; the named cache volume is kept
docker builder prune -f --filter until=168h

used="$(docker run --rm --entrypoint df -v /var/lib/docker:/d:ro "${RUNNER_IMAGE}" -P /d |
    awk 'NR == 2 { sub("%", "", $5); print $5 }')"
log "engine disk ${used}% used (threshold ${PRUNE_AT_PERCENT}%)"
if [ "${used}" -ge "${PRUNE_AT_PERCENT}" ]; then
    docker image prune -a -f --filter 'label!=org.opencontainers.image.title=abd/github-runner'
fi
docker system df
